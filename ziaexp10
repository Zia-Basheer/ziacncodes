#include <stdio.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <linux/if_ether.h>
#include <netpacket/packet.h>
int main(){
    int n,s;
    unsigned char buff[65536];
    s=socket(AF_PACKET,SOCK_RAW,htons(ETH_P_ALL));
    if(s<0){
        perror("socket");
        return 1;
    }
    printf("\n PACKET CAPTURE STARTED\n");
    while(1){
    n=recvfrom(s,buff,sizeof(buff),0,NULL,NULL);
    if(n<14)
        continue;
    printf("\n PACKET LENGTH : %d BYTES\n",n);
    printf("\n DESTINATION MAC\n");
    for(int i=0;i<6;i++){
        printf("%02X\n",buff[i]);
    }
    printf("\n SOURCE MAC\n");
    for(int i=6;i<12;i++){
        printf("%02X\n",buff[i]);
}   
int type=(buff[12] <<8)|buff[13];
printf("\nETHERTYPE : 0x%04X\n",type);
}
close(s);
return 0;
}